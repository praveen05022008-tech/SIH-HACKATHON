# ==============================================================================
# MAYAN-SAFE: AI-Powered SIF Precursor Intelligence Platform
# Environment Configuration Template
# ==============================================================================

# Primary Database (TiDB Cloud MySQL protocol)
DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/test

# Security & Authentication
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENV=production

# Hugging Face (Whisper-v3 Speech-to-Text)
HF_TOKEN=hf_your_token_here
HUGGINGFACE_API_KEY=hf_your_token_here

# Cloudinary (Evidence Photo Storage)
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# AI Engine (Cerebras Llama-3.1 Inference)
AI_PROVIDER=cerebras
AI_API_KEY=your_cerebras_key
AI_BASE_URL=https://api.cerebras.ai/v1
AI_MODEL=llama3.1-8b
