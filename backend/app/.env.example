DATABASE_URL=mysql+pymysql://<USER>:<PASSWORD>@<HOST>:4000/sys
SECRET_KEY=your_secret_key_here
ACCESS_TOKEN_EXPIRE_MINUTES=1440
ENV=development

# SIF-SHIELD AI LLM Configuration (Cerebras / Groq / OpenAI / Gemini / Ollama)
AI_PROVIDER=cerebras
AI_API_KEY=your_cerebras_or_openai_api_key_here
AI_BASE_URL=https://api.cerebras.ai/v1
AI_MODEL=gpt-oss-120b
